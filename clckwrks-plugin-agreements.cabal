cabal-version:       2.4
name:                clckwrks-plugin-agreements
version:             0.1.0
synopsis:            A plugin for Terms & Agreements, Privacy Policies, etc.
description:         Keep track of your sites legal documents and which users have agreed to the terms
homepage:            http://www.clckwrks.com/
license:             BSD-3-Clause
license-file:        LICENSE
copyright:           2023 Jeremy Shaw, SeeReason Partners LLC
author:              Jeremy Shaw
maintainer:          jeremy@seereason.com
category:            Clckwrks
build-type:          Simple
tested-with:         GHC == 8.0.2, GHC == 8.2.2, GHC == 8.4.1, GHC == 8.6.3, GHC == 8.8.3, GHC == 8.10.2

flag arch_javascript
  description: Stand-in for arch(javascript). Remove if not using haskell.nix.
  default: False
  manual: True

source-repository head
    type:     git
    location: git://github.com/clckwrks/clckwrks-plugin-agreements.git

common shared-properties
   default-language: Haskell2010

common shared-ghcjs-properties
   default-language: Haskell2010
   build-depends:    chili

library
  import: shared-properties
  build-depends: base
               , aeson
               , bytestring
               , cereal
               , containers
               , ghc-prim
               , ixset-typed
               , lens
               , safecopy
               , text
               , time
               , userid
               , web-routes
               , web-routes-th

  -- flag(arch_javascript): stand-in for arch(javascript); remove if not using haskell.nix.
  if !impl(ghcjs) && !flag(arch_javascript)
    build-depends: acid-state
                 , clckwrks >= 0.28.1
                 , filepath
                 , happstack-authenticate >= 3.0
                 , happstack-hsp
                 , happstack-server
                 , http-client
                 , http-client-tls
                 , http-types
                 , hsp
                 , hsx2hs
                 , mtl
                 , stm
                 , unordered-containers
                 , vector
                 , web-plugins
  if impl(ghcjs) || arch(javascript)
   build-depends: chili,
                  ghcjs-base,
                  happstack-authenticate >= 3.0,
                  http-types

  hs-source-dirs: src
  if !impl(ghcjs) && !arch(javascript)
      exposed-modules:
              Clckwrks.Agreements.API
              Clckwrks.Agreements.Acid
              Clckwrks.Agreements.Monad
              Clckwrks.Agreements.Page.Template
              Clckwrks.Agreements.Page.ViewAgreement
              Clckwrks.Agreements.Plugin
              Clckwrks.Agreements.Route
  if impl(ghcjs) || arch(javascript)
      exposed-modules:
              Clckwrks.Agreements.SignupPlugin
  exposed-modules:
                  Clckwrks.Agreements.Types
                  Clckwrks.Agreements.URL


executable             agreements-settings
  import:              shared-ghcjs-properties
  if impl(ghcjs) || arch(javascript)
    buildable: True
  else
    buildable: False
  hs-source-dirs:      agreements-settings
  main-is:             AgreementsSettings.hs
  other-modules:       Chili.FormArrow
  build-depends:       base
                     , bytestring
                     , cereal
                     , chili
                     , clckwrks-plugin-agreements
                     , containers
                     , http-types
                     , lens
                     , mtl
                     , safecopy
                     , stm
                     , reform
                     , reform-hsp
                     , text
                     , time
                     , userid
                     , template-haskell
                     , web-routes
  if impl(ghcjs)
    build-depends: ghcjs-base, ghcjs-dom
  if arch(javascript)
    build-depends: ghcjs-base >= 0.8.0.2, ghcjs-dom-javascript >= 0.9.9.3


executable             agreements-signup-plugin
  import:              shared-ghcjs-properties
  if impl(ghcjs) || arch(javascript)
    buildable: False
  else
    buildable: False
  hs-source-dirs:      agreements-signup-plugin
  main-is:             AgreementsSignupPlugin.hs
  build-depends:       base
                     , bytestring
                     , cereal
                     , chili
                     , clckwrks-plugin-agreements
                     , containers
                     , happstack-authenticate >= 3.0
                     , http-types
                     , lens
                     , mtl
                     , safecopy
                     , stm
                     , reform
                     , reform-hsp
                     , text
                     , time
                     , userid
                     , template-haskell
                     , web-routes
  if impl(ghcjs)
    build-depends: ghcjs-base, ghcjs-dom
  if arch(javascript)
    build-depends: ghcjs-base >= 0.8.0.2, ghcjs-dom-javascript >= 0.9.9.3
